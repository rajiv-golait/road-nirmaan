{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "RoadNirman (Real Device)",
      "request": "launch",
      "type": "dart",
      "args": [
        "--dart-define=FLASK_URL=http://YOUR_LAN_IP:5000",
        "--dart-define=MAPBOX_TOKEN=YOUR_MAPBOX_PUBLIC_TOKEN",
        "--dart-define=ALLOW_MOCK_DATA=false",
        "--dart-define=ALLOW_DEMO_LOGIN=false"
      ]
    },
    {
      "name": "RoadNirman (Emulator)",
      "request": "launch",
      "type": "dart",
      "args": [
        "--dart-define=FLASK_URL=http://10.0.2.2:5000",
        "--dart-define=MAPBOX_TOKEN=YOUR_MAPBOX_PUBLIC_TOKEN",
        "--dart-define=ALLOW_MOCK_DATA=false",
        "--dart-define=ALLOW_DEMO_LOGIN=false"
      ]
    }
  ]
}
